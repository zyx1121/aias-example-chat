# The platform injects all of these on a user machine. Set them by hand for
# local development only.

PORT=41100

# Base URL of the model instance, ends in /v1, OpenAI compatible.
AIAS_MODEL_CHAT_URL=http://127.0.0.1:41199/v1
# The model name to put in the request body.
AIAS_MODEL_CHAT_ID=mock

# Postgres DSN scoped to this app's own database.
DATABASE_URL=postgres://example_chat@127.0.0.1:5432/example_chat
