{
  "name": "aias-example-chat",
  "version": "0.1.0",
  "description": "Example AI App Store app: chat with one local model, history in Postgres",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "aias:build": "bun run scripts/aias-build.mjs",
    "start": "node .next/standalone/server.js",
    "migrate": "bun run scripts/migrate.mjs",
    "mock-model": "node scripts/mock-model.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.4",
    "openai": "^7.15.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
